# Copy to .dev.vars (git-ignored) and fill in. Never commit real values.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
SITE_URL=http://localhost:8788
HIDE_CATEGORIES=Cocktails,Wine,Sake,Beer
HIDE_MODIFIER_LISTS=
# "*" = all other categories, A–Z
CATEGORY_ORDER=Appetizers,*,Desserts,Drinks
PREP_TIME=PT20M
