# Copy to .dev.vars (git-ignored) and fill in. Never commit real values.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
SITE_URL=http://localhost:8788
HIDE_CATEGORIES=Beer,Red Wine,White Wine,Sake,Signature Cocktails,Alcoholic Drinks
HIDE_MODIFIER_LISTS=
HIDE_MODIFIERS=$1 Key,$1.5 Key,$2 Key,$3 Key
# "*" = all other categories, A–Z
CATEGORY_ORDER=Hot Appetizers,Cold Appetizers,Soups & Salads,Maki Roll,Special Roll,Cucumber Hand Roll,Nigiri,Sashimi,Sushi Bar Specials,Entrees Sushi Bar,House Specials,Teriyaki,Tempura,Don Buri,Don & Udon,Udon / Soba / Ramen,Yakimeshi,Nabemono,Lunch Boxes,Lunch Box Combo,*,Side Order,Desserts,Non Alcoholic
PREP_TIME=PT20M
# Longer prep in busy windows (location time zone). Separate rules with ";".
BUSY_PREP_TIME=FRI-SAT 17:00-19:00 PT30M
# Last pickup = each day's final closing time minus N minutes.
PICKUP_CUTOFF=MON-THU:10,FRI-SAT:15,SUN:10
# Today plus the next N-1 days.
SCHEDULE_DAYS=3
LUNCH_HOURS=MON-SUN 11:00-14:30
LUNCH_ONLY_CATEGORIES=Lunch Boxes,Lunch Box Combo,Lunch Sushi Bar Specials,Lunch Don & Udon
